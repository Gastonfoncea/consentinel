# Copy to .env.local and fill in real values for local dev.
# All vars are optional in dev — sensible defaults work on localhost.

# WebAuthn relying party identity. For Vercel deploy, set RP_ID to your
# domain (e.g. consentinel.vercel.app) and RP_ORIGIN to https://<rp_id>.
RP_ID=localhost
RP_ORIGIN=http://localhost:3000

# Used to encrypt+sign the session cookie. Must be 32+ chars.
# In production set this to a long random secret.
SESSION_PASSWORD=consentinel_dev_session_password_change_me_min_32_chars

# Web Push (VAPID). Generate with:
#   node -e "const wp=require('web-push'); console.log(JSON.stringify(wp.generateVAPIDKeys()))"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY (the client subscribes
# with the public half — the leading NEXT_PUBLIC_ is what makes Next inline it).
VAPID_SUBJECT=mailto:dev@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Bearer token expected by the voice step-up callback endpoints.
# Use the same secret from your Kapso/ElevenLabs integration.
STEP_UP_SERVICE_TOKEN=change_me_step_up_service_token

# Optional dedicated bearer token for the remote MCP server exposed at /api/mcp.
# If omitted, the server falls back to STEP_UP_SERVICE_TOKEN.
MCP_SERVER_TOKEN=change_me_mcp_server_token

# === Wallet (Base Sepolia testnet — never put real funds) ===
# The kernel uses this to mock-execute USDC transfers.
WALLET_PRIVATE_KEY=0x_your_test_private_key
WALLET_ADDRESS=0x_your_address
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
# MockUSDC address (output of `forge create src/MockUSDC.sol:MockUSDC ...`).
USDC_CONTRACT=0x_deployed_mockusdc_address

# === ElevenLabs Conversational AI (voice biometric step-up) ===
# API key from https://elevenlabs.io/app/developers/api-keys
# Required scopes: ElevenAgents=Write, User=Read.
ELEVENLABS_API_KEY=sk_...
# Agent ID from https://elevenlabs.io/app/conversational-ai/agents
ELEVENLABS_AGENT_ID=

# === Anthropic (kernel intent drift, optional) ===
# If empty the kernel falls back to a heuristic drift evaluator.
ANTHROPIC_API_KEY=sk-ant-...

# === Public URL for local dev (ngrok / cloudflared tunnel) ===
# When running `ngrok http 3000`, paste the https URL here so the
# ElevenLabs custom tools can POST callbacks at
# {SERVER_URL}/api/elevenlabs/decision.
SERVER_URL=
