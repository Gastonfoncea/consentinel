# Demo wallet on Base Sepolia (testnet only — never put real funds here)
WALLET_PRIVATE_KEY=0x_your_test_private_key
WALLET_ADDRESS=0x_your_address

# Network
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# MockUSDC contract address (output of `forge create src/MockUSDC.sol:MockUSDC ...`)
USDC_CONTRACT=0x_deployed_mockusdc_address

# Anthropic (already used by kernel)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs Conversational AI (voice biometric step-up)
# Create the API key at https://elevenlabs.io/app/developers/api-keys
# Required scopes: ElevenAgents=Write, User=Read (rest can be No Access).
ELEVENLABS_API_KEY=sk_...
# Get the agent ID from the agent page in https://elevenlabs.io/app/conversational-ai/agents
ELEVENLABS_AGENT_ID=
# Get the phone number ID from Conversational AI -> Phone Numbers
ELEVENLABS_PHONE_NUMBER_ID=
# Generated by ElevenLabs when you configure the post-call webhook in
# Developers -> Webhooks (only fill once SERVER_URL below is set)
ELEVENLABS_WEBHOOK_SECRET=

# Phone number that will receive the verification call, in E.164 format
# (e.g. +5493512831825 for an Argentine mobile in Cordoba).
DEMO_USER_PHONE_E164=

# Public URL where the local webhook server is reachable (filled when you run
# `npm run tunnel` and ngrok prints the https URL). Used both by our backend
# and by ElevenLabs custom tools to POST decisions back.
SERVER_URL=
